<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Shouldly" />
    <PackageReference Include="Moq" />
    <PackageReference Include="coverlet.collector" />
    <!-- Test-only: drives the real VitriLedgerView + VitriLedgerViewModel through Avalonia's
         headless platform (no Avalonia.Headless.XUnit — session is started/dispatched by hand,
         see Finance/HeadlessTestSupport.cs) so the View<->ViewModel wiring itself is covered,
         not just the view-model in isolation. -->
    <PackageReference Include="Avalonia.Headless" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!-- xunit.runner.json tắt chạy song song giữa các lớp test (parallelizeTestCollections=false). ĐỪNG bật lại mà chưa chạy cả bộ
       test 30 lần liền không lỗi. Lý do: ClosedXML ghi và đọc lại gói .xlsx qua System.IO.Packaging; khi nhiều lớp test cùng dựng gói,
       lúc mở lại gói vừa ghi, System.IO.Packaging.ZipPackage.ContentTypeHelper thỉnh thoảng (~7% số lần chạy cả bộ) thêm content-type
       "rels" hai lần và ném ArgumentException "An item with the same key has already been added. Key: rels". Đó là lỗi đồng thời
       của thư viện, không phải của ứng dụng (app chỉ ghi MỘT workbook mỗi lần, trong Task.Run, và AsyncRelayCommand chặn vào lại).
       Một cổng test đỏ ~7% số lần sẽ bị bỏ qua đúng vào lần nó đỏ vì lỗi thật. -->
  <ItemGroup>
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ConstructionFinance.Desktop\ConstructionFinance.Desktop.csproj" />
    <ProjectReference Include="..\..\src\ConstructionFinance.Application\ConstructionFinance.Application.csproj" />
    <ProjectReference Include="..\..\src\ConstructionFinance.Domain\ConstructionFinance.Domain.csproj" />
  </ItemGroup>

</Project>
