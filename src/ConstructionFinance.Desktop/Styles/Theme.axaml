<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="using:FluentAvalonia.UI.Controls">

    <Styles.Resources>
        <!-- ===== Brand / color tokens ===== -->
        <Color x:Key="BrandPrimaryColor">#1C4E80</Color>
        <SolidColorBrush x:Key="BrandPrimaryBrush" Color="#1C4E80"/>
        <SolidColorBrush x:Key="BrandPrimaryDarkBrush" Color="#163E66"/>
        <!-- Soft brand tints for row hover / selection / subtle fills -->
        <SolidColorBrush x:Key="AccentSoftBrush" Color="#EBF1F8"/>
        <SolidColorBrush x:Key="AccentSoftHoverBrush" Color="#F1F5FA"/>

        <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F4F6FA"/>
        <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="CardBorderBrush" Color="#E6EBF2"/>
        <SolidColorBrush x:Key="ToolbarStripBrush" Color="#FBFCFE"/>

        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1A2233"/>
        <SolidColorBrush x:Key="TextMutedBrush" Color="#6B7688"/>

        <SolidColorBrush x:Key="GridHeaderBrush" Color="#F1F4F9"/>
        <SolidColorBrush x:Key="GridLineBrush" Color="#EAEEF4"/>

        <SolidColorBrush x:Key="DangerBrush" Color="#C0392B"/>
        <SolidColorBrush x:Key="WarningBrush" Color="#B7791F"/>
        <Color x:Key="SuccessColor">#2E7D32</Color>
        <SolidColorBrush x:Key="SuccessBrush" Color="#2E7D32"/>

        <SolidColorBrush x:Key="InfoBarBackgroundBrush" Color="#FFF8E1"/>
        <SolidColorBrush x:Key="InfoBarBorderBrush" Color="#F0D27A"/>
        <SolidColorBrush x:Key="InfoBarTextBrush" Color="#7A5B17"/>

        <!-- ===== Navigation pane: deep-blue, high-contrast (applied via the SplitView + item styles below) ===== -->
        <SolidColorBrush x:Key="NavPaneBrush" Color="#15355A"/>
        <!-- Điểm nhấn ấm (hổ phách) dùng rất tiết kiệm: vạch chọn ở thanh bên và tab — để xanh navy khỏi đơn điệu. -->
        <SolidColorBrush x:Key="WarmAccentBrush" Color="#E9A23B"/>

        <!-- FluentAvalonia NavigationView: thanh bên navy, chữ sáng, mục đang chọn nền sáng nhẹ + vạch hổ phách. -->
        <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="#15355A"/>
        <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="#15355A"/>
        <SolidColorBrush x:Key="NavigationViewTopPaneBackground" Color="#15355A"/>
        <SolidColorBrush x:Key="NavigationViewItemForeground" Color="#D3E0EF"/>
        <SolidColorBrush x:Key="NavigationViewItemForegroundPointerOver" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="NavigationViewItemForegroundPressed" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="NavigationViewItemForegroundSelected" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="NavigationViewItemForegroundSelectedPointerOver" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="NavigationViewItemForegroundSelectedPressed" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="NavigationViewItemBackgroundPointerOver" Color="#1FFFFFFF"/>
        <SolidColorBrush x:Key="NavigationViewItemBackgroundPressed" Color="#2BFFFFFF"/>
        <SolidColorBrush x:Key="NavigationViewItemBackgroundSelected" Color="#2EFFFFFF"/>
        <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPointerOver" Color="#38FFFFFF"/>
        <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPressed" Color="#38FFFFFF"/>
        <SolidColorBrush x:Key="NavigationViewItemHeaderForeground" Color="#8FA9C8"/>
        <SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground" Color="#E9A23B"/>
        <SolidColorBrush x:Key="NavigationViewButtonForegroundPointerOver" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="NavigationViewButtonForegroundPressed" Color="#FFFFFF"/>

        <!-- Tab ở đáy sổ (kiểu tab trang tính): chữ vừa phải, tab đang chọn đậm + vạch nhấn. -->
        <x:Double x:Key="TabItemHeaderFontSize">14</x:Double>
        <SolidColorBrush x:Key="TabItemForeground" Color="#46546B"/>
        <SolidColorBrush x:Key="TabItemForegroundPointerOver" Color="#1C4E80"/>
        <SolidColorBrush x:Key="TabItemForegroundSelected" Color="#1C4E80"/>
        <SolidColorBrush x:Key="TabItemBackgroundPointerOver" Color="#EBF1F8"/>
        <SolidColorBrush x:Key="TabItemBackgroundSelected" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TabItemSelectionIndicatorColor" Color="Transparent"/>
    </Styles.Resources>

    <!-- ===== Card surface ===== -->
    <Style Selector="Border.card">
        <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="18"/>
        <Setter Property="BoxShadow" Value="0 4 14 0 #10141F2E"/>
    </Style>

    <!-- ===== Typography ===== -->
    <Style Selector="TextBlock.pageTitle">
        <Setter Property="FontSize" Value="22"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource BrandPrimaryDarkBrush}"/>
    </Style>
    <Style Selector="TextBlock.pageSubtitle">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
    </Style>
    <Style Selector="TextBlock.sectionTitle">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
    </Style>
    <Style Selector="TextBlock.muted">
        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
    </Style>

    <!-- ===== Table card: a card holding a toolbar strip + DataGrid (no inner padding) ===== -->
    <Style Selector="Border.tableCard">
        <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="ClipToBounds" Value="True"/>
        <Setter Property="BoxShadow" Value="0 4 14 0 #10141F2E"/>
    </Style>

    <!-- ===== Toolbar strip attached to the top of a table card ===== -->
    <Style Selector="Border.toolbarStrip">
        <Setter Property="Background" Value="{StaticResource ToolbarStripBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="Padding" Value="14,10"/>
    </Style>

    <!-- ===== Info / read-only banner ===== -->
    <Style Selector="Border.infoBar">
        <Setter Property="Background" Value="{StaticResource InfoBarBackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource InfoBarBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="12,8"/>
    </Style>
    <Style Selector="Border.infoBar TextBlock">
        <Setter Property="Foreground" Value="{StaticResource InfoBarTextBrush}"/>
    </Style>

    <!-- ===== Toolbar buttons: a touch more breathing room ===== -->
    <Style Selector="Button.toolbar">
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="12,7"/>
    </Style>
    <!-- Nút In ở đáy thanh bên (màu nút khai ở Button.Resources trong MainWindow.axaml — Style.Resources rò ra mọi nút): nền hổ phách, chữ navy đậm — nổi bật trên nền navy, là điểm nhấn ấm duy nhất của thanh bên. -->
    <Style Selector="Button#PrintButton">
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="12,9"/>
    </Style>
    <Style Selector="Button.danger">
        <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
    </Style>

    <!-- ===== Detail field label / value pairs ===== -->
    <Style Selector="TextBlock.fieldLabel">
        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0,0,0,6"/>
    </Style>
    <Style Selector="TextBlock.fieldValue">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0,0,0,6"/>
    </Style>
    <Style Selector="TextBlock.fieldValueStrong">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0,0,0,6"/>
    </Style>

    <!-- ===== Dialog forms: consistent label + input ===== -->
    <Style Selector="TextBlock.formLabel">
        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="TextBlock.fieldError">
        <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Margin" Value="0,2,0,0"/>
    </Style>

    <!-- Vertical + horizontal rhythm for dialog form grids (Grid.RowSpacing needs Avalonia 11.3+). -->
    <Style Selector="Grid.formGrid &gt; :is(Control)">
        <Setter Property="Margin" Value="0,6,12,6"/>
    </Style>

    <!-- ===== DataGrid polish ===== -->
    <Style Selector="DataGrid">
        <Setter Property="RowHeight" Value="40"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="GridLinesVisibility" Value="Horizontal"/>
        <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource GridLineBrush}"/>
    </Style>
    <Style Selector="DataGridColumnHeader">
        <Setter Property="Background" Value="{StaticResource GridHeaderBrush}"/>
        <Setter Property="BorderBrush" Value="#CBD6E4"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="MinHeight" Value="42"/>
        <Setter Property="Padding" Value="12,0"/>
    </Style>
    <!-- Row hover + selection tint -->
    <Style Selector="DataGridRow:pointerover /template/ Rectangle#BackgroundRectangle">
        <Setter Property="Fill" Value="{StaticResource AccentSoftHoverBrush}"/>
        <Setter Property="Opacity" Value="1"/>
    </Style>
    <Style Selector="DataGridRow:selected /template/ Rectangle#BackgroundRectangle">
        <Setter Property="Fill" Value="{StaticResource AccentSoftBrush}"/>
        <Setter Property="Opacity" Value="1"/>
    </Style>
    <Style Selector="DataGridRow:selected DataGridCell TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
    </Style>

    <!-- ===== Bảng báo cáo (Tổng hợp, Quyết toán năm): đọc như tờ in theo Mẫu ===== -->
    <Style Selector="DataGrid.report">
        <Setter Property="GridLinesVisibility" Value="All"/>
        <Setter Property="VerticalGridLinesBrush" Value="{StaticResource GridLineBrush}"/>
        <Setter Property="RowHeight" Value="34"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="#CBD6E4"/>
    </Style>
    <Style Selector="DataGrid.report DataGridColumnHeader">
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="MinHeight" Value="56"/>
        <Setter Property="Padding" Value="6,4"/>
        <Setter Property="FontSize" Value="12"/>
        <!-- Tiêu đề nhiều dòng (&#10;) căn giữa từng dòng như ô tiêu đề của Mẫu. Đặt ContentTemplate ở đây vô ích: ô tiêu
             đề nhận HeaderTemplate của cột làm giá trị cục bộ, đè lên style. TextAlignment thì kế thừa xuống TextBlock. -->
        <Setter Property="TextBlock.TextAlignment" Value="Center"/>
    </Style>
    <Style Selector="DataGrid.report DataGridCell.money">
        <Setter Property="HorizontalContentAlignment" Value="Right"/>
    </Style>
    <Style Selector="DataGrid.report DataGridCell.center">
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
    </Style>

    <!-- ===== Excel-like entry grid cell styles ===== -->
    <Style Selector="TextBlock.gridHeaderCell">
        <Setter Property="Padding" Value="8,8"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="TextBlock.gridTotalCell">
        <Setter Property="Padding" Value="8,8"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="Grid.gridRow">
        <Setter Property="MinHeight" Value="34"/>
    </Style>
    <Style Selector="TextBox.gridCell">
        <Setter Property="BorderBrush" Value="{DynamicResource GridLineBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,1,1"/>
        <Setter Property="CornerRadius" Value="0"/>
        <Setter Property="Padding" Value="6,4"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="TextBox.gridCell.num">
        <Setter Property="TextAlignment" Value="Right"/>
    </Style>
    <Style Selector="TextBox.gridCell:focus">
        <Setter Property="BorderBrush" Value="{DynamicResource BrandPrimaryBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style Selector="TextBlock.gridCellRO">
        <Setter Property="Padding" Value="6,4"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="TextBlock.gridCellRO.num">
        <Setter Property="TextAlignment" Value="Right"/>
    </Style>

    <!-- ===== Tab trang tính ở đáy sổ: thẻ phẳng, tab đang chọn trắng + vạch hổ phách phía trên ===== -->
    <Style Selector="TabControl#ViTriTabs">
        <Setter Property="Background" Value="#E8EDF5"/>
        <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}"/>
        <Setter Property="BorderThickness" Value="0,1,0,0"/>
        <Setter Property="Padding" Value="0"/>
    </Style>
    <Style Selector="TabItem Border.tabChip">
        <Setter Property="Padding" Value="18,9"/>
        <Setter Property="BorderThickness" Value="0,3,0,0"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="TabItem Border.tabChip TextBlock">
        <Setter Property="Foreground" Value="#46546B"/>
    </Style>
    <Style Selector="TabItem:pointerover Border.tabChip TextBlock">
        <Setter Property="Foreground" Value="{StaticResource BrandPrimaryBrush}"/>
    </Style>
    <Style Selector="TabItem:pointerover Border.tabChip">
        <Setter Property="Background" Value="#F3F6FB"/>
    </Style>
    <Style Selector="TabItem:selected Border.tabChip">
        <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource WarmAccentBrush}"/>
    </Style>
    <Style Selector="TabItem:selected Border.tabChip TextBlock">
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource BrandPrimaryBrush}"/>
    </Style>

    <!-- ===== Navigation pane: chữ mục chọn đậm hơn một chút ===== -->
    <Style Selector="ui|NavigationViewItem:selected">
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

</Styles>
