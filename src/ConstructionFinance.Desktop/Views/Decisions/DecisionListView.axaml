<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:vm="using:ConstructionFinance.Desktop.ViewModels.Decisions"
             x:Class="ConstructionFinance.Desktop.Views.Decisions.DecisionListView"
             x:DataType="vm:DecisionListViewModel">
    <DockPanel>
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,16">
            <StackPanel Grid.Column="0" Spacing="2">
                <TextBlock Classes="pageTitle" Text="Quyết định"/>
                <TextBlock Classes="pageSubtitle" Text="Quyết định phê duyệt — nguồn dữ liệu gốc"/>
            </StackPanel>
            <Button Grid.Column="1" Classes="accent toolbar" VerticalAlignment="Center"
                    Command="{Binding AddCommand}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <ui:SymbolIcon Symbol="{x:Static ui:Symbol.Add}"/>
                    <TextBlock Text="Thêm quyết định"/>
                </StackPanel>
            </Button>
        </Grid>

        <Border Classes="tableCard">
            <DockPanel>
                <Border DockPanel.Dock="Top" Classes="toolbarStrip">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                            <Button Classes="toolbar" Command="{Binding EditCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <ui:SymbolIcon Symbol="{x:Static ui:Symbol.Edit}"/>
                                    <TextBlock Text="Sửa"/>
                                </StackPanel>
                            </Button>
                            <Button Classes="toolbar danger" Command="{Binding DeleteCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <ui:SymbolIcon Symbol="{x:Static ui:Symbol.Delete}"/>
                                    <TextBlock Text="Xóa"/>
                                </StackPanel>
                            </Button>
                            <Button Classes="toolbar" Command="{Binding OpenDetailCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <ui:SymbolIcon Symbol="{x:Static ui:Symbol.ChevronRight}"/>
                                    <TextBlock Text="Chi tiết"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding ErrorMessage}"
                                   Foreground="{DynamicResource DangerBrush}"
                                   VerticalAlignment="Center" HorizontalAlignment="Right" Margin="12,0"/>
                        <ProgressBar Grid.Column="2" IsIndeterminate="True" IsVisible="{Binding IsBusy}"
                                     Width="100" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
                <DataGrid ItemsSource="{Binding Decisions}"
                          SelectedItem="{Binding SelectedDecision}"
                          IsReadOnly="True"
                          HeadersVisibility="Column">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Mã QĐ" Binding="{Binding DecisionCode}" Width="180"/>
                        <DataGridTextColumn Header="Trích yếu" Binding="{Binding DecisionTitle}" Width="*"/>
                        <DataGridTextColumn Header="Ngày" Binding="{Binding DecisionDate}" Width="110"/>
                        <DataGridTextColumn Header="Cơ quan" Binding="{Binding IssuingAuthority}" Width="220"/>
                        <DataGridTextColumn Header="Tổng giá trị" Binding="{Binding TotalApprovedAmount, StringFormat=#\,##0}" Width="160"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>
    </DockPanel>
</UserControl>
