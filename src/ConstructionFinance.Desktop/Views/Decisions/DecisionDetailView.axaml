<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:vm="using:ConstructionFinance.Desktop.ViewModels.Decisions"
             x:Class="ConstructionFinance.Desktop.Views.Decisions.DecisionDetailView"
             x:DataType="vm:DecisionDetailViewModel">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="12" Margin="0,0,0,16">
            <Button Classes="toolbar" Command="{Binding GoBackCommand}" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <ui:SymbolIcon Symbol="{x:Static ui:Symbol.ChevronLeft}"/>
                    <TextBlock Text="Quay lại"/>
                </StackPanel>
            </Button>
            <TextBlock Classes="pageTitle" VerticalAlignment="Center"
                       Text="{Binding Decision.DecisionCode, StringFormat='Quyết định {0}'}"/>
        </StackPanel>
        <Grid RowDefinitions="Auto,*">
            <Border Grid.Row="0" Classes="card" Margin="0,0,0,16">
                <Grid ColumnDefinitions="180,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto">
                    <TextBlock Grid.Row="0" Grid.Column="0" Classes="fieldLabel" Text="Trích yếu"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" Classes="fieldValueStrong" Text="{Binding Decision.DecisionTitle}" TextWrapping="Wrap"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Classes="fieldLabel" Text="Ngày ban hành"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" Classes="fieldValue" Text="{Binding Decision.DecisionDate}"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Classes="fieldLabel" Text="Cơ quan"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" Classes="fieldValue" Text="{Binding Decision.IssuingAuthority}"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" Classes="fieldLabel" Text="Tổng giá trị duyệt"/>
                    <TextBlock Grid.Row="3" Grid.Column="1" Classes="fieldValue" Text="{Binding Decision.TotalApprovedAmount, StringFormat=#\,##0}"/>

                    <TextBlock Grid.Row="4" Grid.Column="0" Classes="fieldLabel" Text="Ghi chú"/>
                    <TextBlock Grid.Row="4" Grid.Column="1" Classes="fieldValue" Text="{Binding Decision.Notes}" TextWrapping="Wrap"/>
                </Grid>
            </Border>
            <DockPanel Grid.Row="1">
                <TextBlock DockPanel.Dock="Top" Text="Hợp đồng thuộc Quyết định này"
                           Classes="sectionTitle" Margin="0,0,0,8"/>
                <ContentControl Content="{Binding Contracts}"/>
            </DockPanel>
        </Grid>
    </DockPanel>
</UserControl>
