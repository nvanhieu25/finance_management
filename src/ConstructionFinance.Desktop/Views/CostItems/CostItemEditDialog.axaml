<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ConstructionFinance.Desktop.ViewModels.CostItems"
             xmlns:dto="using:ConstructionFinance.Application.DTOs"
             x:Class="ConstructionFinance.Desktop.Views.CostItems.CostItemEditDialog"
             x:DataType="vm:CostItemEditDialogViewModel"
             MinWidth="520">
    <Grid ColumnDefinitions="160,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto">
        <TextBlock Grid.Row="0" Grid.Column="0" Text="Tên đầu mục *" VerticalAlignment="Center" Margin="0,6"/>
        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding ItemName}" Margin="0,6"/>

        <TextBlock Grid.Row="1" Grid.Column="0" Text="Loại đầu mục" VerticalAlignment="Center" Margin="0,6"/>
        <CheckBox Grid.Row="1" Grid.Column="1" IsChecked="{Binding IsLeaf}" Content="Là mục lá (chứa chi phí, không có con)" Margin="0,6"/>

        <TextBlock Grid.Row="2" Grid.Column="0" Text="Đơn vị tính" VerticalAlignment="Center" Margin="0,6"/>
        <ComboBox Grid.Row="2" Grid.Column="1"
                  ItemsSource="{Binding Units}"
                  SelectedItem="{Binding SelectedUnit}"
                  Margin="0,6">
            <ComboBox.ItemTemplate>
                <DataTemplate DataType="dto:CostUnitTypeDto">
                    <TextBlock Text="{Binding Code}"/>
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>

        <TextBlock Grid.Row="3" Grid.Column="0" Text="Nhà cung cấp" VerticalAlignment="Center" Margin="0,6"/>
        <ComboBox Grid.Row="3" Grid.Column="1"
                  ItemsSource="{Binding Vendors}"
                  SelectedItem="{Binding SelectedVendor}"
                  Margin="0,6">
            <ComboBox.ItemTemplate>
                <DataTemplate DataType="dto:VendorDto">
                    <TextBlock Text="{Binding VendorName}"/>
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>

        <TextBlock Grid.Row="4" Grid.Column="0" Text="Gói thầu" VerticalAlignment="Center" Margin="0,6"/>
        <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding BidPackage}" Margin="0,6"/>

        <TextBlock Grid.Row="5" Grid.Column="0" Text="Ghi chú" VerticalAlignment="Top" Margin="0,6"/>
        <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding Notes}" AcceptsReturn="True" Height="80" TextWrapping="Wrap" Margin="0,6"/>
    </Grid>
</UserControl>
