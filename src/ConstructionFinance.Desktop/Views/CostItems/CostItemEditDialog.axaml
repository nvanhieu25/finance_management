<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ConstructionFinance.Desktop.ViewModels.CostItems"
             xmlns:dto="using:ConstructionFinance.Application.DTOs"
             x:Class="ConstructionFinance.Desktop.Views.CostItems.CostItemEditDialog"
             x:DataType="vm:CostItemEditDialogViewModel"
             MinWidth="520">
    <Grid ColumnDefinitions="160,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto"
          Classes="formGrid">
        <TextBlock Grid.Row="0" Grid.Column="0" Classes="formLabel" Text="Tên đầu mục *"/>
        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding ItemName}"/>

        <TextBlock Grid.Row="1" Grid.Column="0" Classes="formLabel" Text="Loại đầu mục"/>
        <CheckBox Grid.Row="1" Grid.Column="1" IsChecked="{Binding IsLeaf}" Content="Là mục lá (chứa chi phí, không có con)"/>

        <TextBlock Grid.Row="2" Grid.Column="0" Classes="formLabel" Text="Đơn vị tính"/>
        <ComboBox Grid.Row="2" Grid.Column="1"
                  ItemsSource="{Binding Units}"
                  SelectedItem="{Binding SelectedUnit}">
            <ComboBox.ItemTemplate>
                <DataTemplate DataType="dto:CostUnitTypeDto">
                    <TextBlock Text="{Binding Code}"/>
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>

        <TextBlock Grid.Row="3" Grid.Column="0" Classes="formLabel" Text="Nhà cung cấp"/>
        <ComboBox Grid.Row="3" Grid.Column="1"
                  ItemsSource="{Binding Vendors}"
                  SelectedItem="{Binding SelectedVendor}">
            <ComboBox.ItemTemplate>
                <DataTemplate DataType="dto:VendorDto">
                    <TextBlock Text="{Binding VendorName}"/>
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>

        <TextBlock Grid.Row="4" Grid.Column="0" Classes="formLabel" Text="Gói thầu"/>
        <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding BidPackage}"/>

        <TextBlock Grid.Row="5" Grid.Column="0" Classes="formLabel" Text="Ghi chú" VerticalAlignment="Top"/>
        <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding Notes}" AcceptsReturn="True" Height="80" TextWrapping="Wrap"/>
    </Grid>
</UserControl>
