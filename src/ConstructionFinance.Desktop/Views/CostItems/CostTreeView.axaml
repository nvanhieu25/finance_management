<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ConstructionFinance.Desktop.ViewModels.CostItems"
             x:Class="ConstructionFinance.Desktop.Views.CostItems.CostTreeView"
             x:DataType="vm:CostTreeViewModel">
    <DockPanel>
        <!-- Toolbar -->
        <Border DockPanel.Dock="Top" BorderBrush="#DDDDDD" BorderThickness="0,0,0,1" Padding="0,0,0,8" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="+ Đầu mục gốc" Command="{Binding AddRootCommand}"/>
                <Button Content="+ Mục con" Command="{Binding AddChildCommand}"/>
                <Button Content="+ Cùng cấp" Command="{Binding AddSiblingCommand}"/>
                <Separator/>
                <Button Content="← Outdent" Command="{Binding OutdentCommand}" ToolTip.Tip="Alt+←"/>
                <Button Content="→ Indent" Command="{Binding IndentCommand}" ToolTip.Tip="Alt+→"/>
                <Separator/>
                <Button Content="Xóa" Command="{Binding DeleteCommand}"/>
                <Separator/>
                <Button Content="✏️ Sửa..." Command="{Binding OpenEditDialogCommand}" ToolTip.Tip="Sửa tên, đơn vị, NCC, gói thầu, ghi chú"/>
                <Button Content="💰 Thanh toán" Command="{Binding OpenPaymentsCommand}"/>
                <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}" Width="80" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding ErrorMessage}" Foreground="Red" VerticalAlignment="Center"/>
                <TextBlock VerticalAlignment="Center" FontWeight="SemiBold"
                           Text="{Binding GrandTotal, StringFormat='Tổng cộng: {0:#\,##0}đ'}"/>
            </StackPanel>
        </Border>

        <!-- Column headers -->
        <Border DockPanel.Dock="Top" Background="#F4F4F4" Padding="8,4">
            <Grid ColumnDefinitions="*,80,100,140,160,140">
                <TextBlock Grid.Column="0" Text="Đầu mục" FontWeight="SemiBold"/>
                <TextBlock Grid.Column="1" Text="Đơn vị" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                <TextBlock Grid.Column="2" Text="Số lượng" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                <TextBlock Grid.Column="3" Text="Đơn giá (VND)" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                <TextBlock Grid.Column="4" Text="Dự toán (VND)" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                <TextBlock Grid.Column="5" Text="Gói thầu" FontWeight="SemiBold"/>
            </Grid>
        </Border>

        <!-- Tree (basic TreeView for MVP; true TreeDataGrid inline editing is v1.1) -->
        <TreeView ItemsSource="{Binding RootNodes}"
                  SelectedItem="{Binding SelectedNode, Mode=TwoWay}">
            <TreeView.ItemTemplate>
                <TreeDataTemplate ItemsSource="{Binding Children}" DataType="vm:CostTreeNode">
                    <Grid ColumnDefinitions="*,80,100,140,160,140" Margin="0,2">
                        <TextBlock Grid.Column="0" Text="{Binding ItemName}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        <TextBox Grid.Column="2" Text="{Binding Quantity}"
                                 TextAlignment="Right" VerticalContentAlignment="Center"
                                 LostFocus="OnCellLostFocus" BorderThickness="0" Background="Transparent" Padding="2,0"/>
                        <TextBox Grid.Column="3" Text="{Binding UnitPrice}"
                                 TextAlignment="Right" VerticalContentAlignment="Center"
                                 LostFocus="OnCellLostFocus" BorderThickness="0" Background="Transparent" Padding="2,0"/>
                        <TextBox Grid.Column="4" Text="{Binding EstimatedAmount}"
                                 TextAlignment="Right" VerticalContentAlignment="Center" FontWeight="SemiBold"
                                 LostFocus="OnCellLostFocus" BorderThickness="0" Background="Transparent" Padding="2,0"/>
                        <TextBlock Grid.Column="5" Text="{Binding BidPackage}" VerticalAlignment="Center"/>
                    </Grid>
                </TreeDataTemplate>
            </TreeView.ItemTemplate>
        </TreeView>
    </DockPanel>
</UserControl>
