<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ConstructionFinance.Desktop.ViewModels"
        xmlns:ui="using:FluentAvalonia.UI.Controls"
        x:Class="ConstructionFinance.Desktop.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding Title}"
        Icon="/Assets/app-icon.png"
        Width="1280" Height="800"
        MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized">
    <DockPanel>
        <!-- Modern compact status bar -->
        <Border DockPanel.Dock="Bottom"
                Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="16,5">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Border Width="7" Height="7" CornerRadius="4"
                            Background="{DynamicResource SuccessBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding StatusText}" FontSize="11.5"
                               Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Grid.Column="2" Text="Ctrl+S: Lưu nhanh  •  Ctrl+V: Dán từ Excel"
                           FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <ui:NavigationView x:Name="Nav"
                           PaneDisplayMode="Left"
                           IsPaneToggleButtonVisible="True"
                           IsSettingsVisible="False"
                           IsBackButtonVisible="False"
                           OpenPaneLength="232">
            <ui:NavigationView.PaneHeader>
                <Border Padding="14,10,14,6">
                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <Border Width="28" Height="28" CornerRadius="7" Background="#2563EB">
                            <ui:SymbolIcon Symbol="{x:Static ui:Symbol.Calculator}"
                                           Foreground="#FFFFFF" FontSize="15"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Spacing="0" VerticalAlignment="Center">
                            <TextBlock Text="TÀI CHÍNH DỰ ÁN" FontSize="12" FontWeight="Bold" Foreground="#F8FAFC"/>
                            <TextBlock Text="Quản lý &amp; Quyết toán" FontSize="10.5" Foreground="#64748B"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </ui:NavigationView.PaneHeader>

            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItemHeader Content="NGHIỆP VỤ"/>
                <ui:NavigationViewItem x:Name="NavFinanceWorkbook" Content="Tài chính dự án" Tag="FinanceWorkbook">
                    <ui:NavigationViewItem.IconSource><ui:SymbolIconSource Symbol="{x:Static ui:Symbol.Calculator}"/></ui:NavigationViewItem.IconSource>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="Tổng hợp" Tag="WorkbookSummary">
                    <ui:NavigationViewItem.IconSource><ui:SymbolIconSource Symbol="{x:Static ui:Symbol.ViewAll}"/></ui:NavigationViewItem.IconSource>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="Thông tri" Tag="ThongTri">
                    <ui:NavigationViewItem.IconSource><ui:SymbolIconSource Symbol="{x:Static ui:Symbol.Mail}"/></ui:NavigationViewItem.IconSource>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="Quyết định" Tag="Decisions">
                    <ui:NavigationViewItem.IconSource><ui:SymbolIconSource Symbol="{x:Static ui:Symbol.Document}"/></ui:NavigationViewItem.IconSource>
                </ui:NavigationViewItem>

                <ui:NavigationViewItemHeader Content="HỆ THỐNG"/>
                <ui:NavigationViewItem Content="Cài đặt" Tag="Settings">
                    <ui:NavigationViewItem.IconSource><ui:SymbolIconSource Symbol="{x:Static ui:Symbol.Settings}"/></ui:NavigationViewItem.IconSource>
                </ui:NavigationViewItem>
            </ui:NavigationView.MenuItems>

            <ui:NavigationView.PaneFooter>
                <StackPanel Margin="0,0,0,6">
                    <!-- Nút In nằm một chỗ cố định ở mọi màn. Màn đang mở không có gì để in thì nút MỜ chứ không ẩn -->
                    <Button x:Name="PrintButton"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            Margin="10,4"
                            IsEnabled="{Binding CanPrint}"
                            ToolTip.Tip="{Binding PrintToolTip}"
                            ToolTip.ShowOnDisabled="True">
                        <Button.Resources>
                            <SolidColorBrush x:Key="ButtonBackground" Color="#2563EB"/>
                            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#3B82F6"/>
                            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#1D4ED8"/>
                            <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="#1E293B"/>
                            <SolidColorBrush x:Key="ButtonForeground" Color="#FFFFFF"/>
                            <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#FFFFFF"/>
                            <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#FFFFFF"/>
                            <SolidColorBrush x:Key="ButtonForegroundDisabled" Color="#475569"/>
                            <SolidColorBrush x:Key="ButtonBorderBrush" Color="#3B82F6"/>
                            <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#60A5FA"/>
                            <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#1D4ED8"/>
                            <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="#334155"/>
                        </Button.Resources>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ui:SymbolIcon Symbol="{x:Static ui:Symbol.Print}" FontSize="15"/>
                            <TextBlock Text="In &amp; Xuất báo cáo"/>
                        </StackPanel>
                        <Button.Flyout>
                            <MenuFlyout Placement="Top">
                                <MenuItem Header="In sheet này" Command="{Binding PrintCurrentSheetCommand}"/>
                                <MenuItem Header="In toàn bộ" Command="{Binding PrintAllCommand}"/>
                                <Separator/>
                                <MenuItem Header="Xuất Excel sheet này" Command="{Binding ExportCurrentSheetCommand}"/>
                                <MenuItem Header="Xuất Excel toàn bộ" Command="{Binding ExportAllCommand}"/>
                                <Separator/>
                                <MenuItem Header="Xuất PDF để in — sheet này" Command="{Binding ExportPdfCurrentSheetCommand}"/>
                                <MenuItem Header="Xuất PDF để in — toàn bộ" Command="{Binding ExportPdfAllCommand}"/>
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>
            </ui:NavigationView.PaneFooter>

            <Border Background="{DynamicResource AppBackgroundBrush}">
                <ContentControl Content="{Binding CurrentContent}" Margin="16,14"/>
            </Border>
        </ui:NavigationView>
    </DockPanel>
</Window>
