<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ConstructionFinance.Desktop.ViewModels.Payments"
             xmlns:common="using:ConstructionFinance.Desktop.Common"
             xmlns:enums="using:ConstructionFinance.Domain.Enums"
             x:Class="ConstructionFinance.Desktop.Views.Payments.PaymentEditDialog"
             x:DataType="vm:PaymentEditDialogViewModel"
             MinWidth="500">
    <Grid ColumnDefinitions="170,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto"
          Classes="formGrid">
        <TextBlock Grid.Row="0" Grid.Column="0" Classes="formLabel" Text="Loại thanh toán"/>
        <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding AvailableTypes}" SelectedItem="{Binding PaymentType}">
            <ComboBox.ItemTemplate>
                <DataTemplate DataType="enums:PaymentType">
                    <TextBlock Text="{Binding ., Converter={x:Static common:EnumToVietnameseConverter.Instance}}"/>
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>

        <TextBlock Grid.Row="1" Grid.Column="0" Classes="formLabel" Text="Ngày thanh toán"/>
        <DatePicker Grid.Row="1" Grid.Column="1"
                    SelectedDate="{Binding PaymentDate, Mode=TwoWay, Converter={x:Static common:DateOnlyConverter.Instance}}"/>

        <TextBlock Grid.Row="2" Grid.Column="0" Classes="formLabel" Text="Số tiền (VND) *"/>
        <StackPanel Grid.Row="2" Grid.Column="1">
            <NumericUpDown Value="{Binding Amount}" Minimum="0" FormatString="#,##0"/>
            <TextBlock Classes="fieldError" Text="{Binding AmountError}"
                       IsVisible="{Binding AmountError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
        </StackPanel>

        <TextBlock Grid.Row="3" Grid.Column="0" Classes="formLabel" Text="% so với dự toán"/>
        <NumericUpDown Grid.Row="3" Grid.Column="1" Value="{Binding Percentage}" Minimum="0" Maximum="100" FormatString="0.00"/>

        <TextBlock Grid.Row="4" Grid.Column="0" Classes="formLabel" Text="Số hóa đơn"/>
        <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding InvoiceNo}"/>

        <TextBlock Grid.Row="5" Grid.Column="0" Classes="formLabel" Text="Ngày hóa đơn"/>
        <DatePicker Grid.Row="5" Grid.Column="1"
                    SelectedDate="{Binding InvoiceDate, Mode=TwoWay, Converter={x:Static common:NullableDateOnlyConverter.Instance}}"/>

        <TextBlock Grid.Row="6" Grid.Column="0" Classes="formLabel" Text="Ghi chú" VerticalAlignment="Top"/>
        <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding Notes}" AcceptsReturn="True" Height="60" TextWrapping="Wrap"/>
    </Grid>
</UserControl>
