<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ConstructionFinance.Desktop.ViewModels.TongHop"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             x:Class="ConstructionFinance.Desktop.Views.TongHop.TongHopView"
             x:DataType="vm:TongHopViewModel">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Spacing="2" Margin="0,0,0,16">
            <TextBlock Text="Bảng tổng hợp" Classes="pageTitle"/>
            <TextBlock Text="Tổng hợp tài chính dự án theo từng lô import" Classes="pageSubtitle"/>
        </StackPanel>

        <Border DockPanel.Dock="Top" Classes="card" Margin="0,0,0,16">
            <StackPanel Spacing="12">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <StackPanel Grid.Column="0" Spacing="3">
                        <TextBlock Text="LÔ IMPORT" Classes="muted" FontSize="11" FontWeight="SemiBold"/>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ComboBox ItemsSource="{Binding Batches}"
                                      SelectedItem="{Binding SelectedBatch}"
                                      MinWidth="320"
                                      DisplayMemberBinding="{Binding SourceFileName}"/>
                            <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}"
                                         Width="80" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8"
                                VerticalAlignment="Bottom">
                        <Button Classes="accent toolbar" Command="{Binding ImportCommand}"
                                ToolTip.Tip="Nhập dữ liệu từ file Excel">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <ui:SymbolIcon Symbol="{x:Static ui:Symbol.Import}"/>
                                <TextBlock Text="Import Excel"/>
                            </StackPanel>
                        </Button>
                        <Button Classes="toolbar" Command="{Binding ExportCommand}"
                                ToolTip.Tip="Xuất bảng tổng hợp ra Excel">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <ui:SymbolIcon Symbol="{x:Static ui:Symbol.SaveAs}"/>
                                <TextBlock Text="Xuất Excel"/>
                            </StackPanel>
                        </Button>
                        <Button Classes="toolbar" Command="{Binding ShowWarningsCommand}"
                                ToolTip.Tip="Xem cảnh báo của lô import đang chọn">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <ui:SymbolIcon Symbol="{x:Static ui:Symbol.Important}"/>
                                <TextBlock Text="Cảnh báo"/>
                            </StackPanel>
                        </Button>
                        <Button Classes="toolbar" Command="{Binding DeleteBatchCommand}"
                                Foreground="{DynamicResource DangerBrush}"
                                ToolTip.Tip="Xóa lô import đang chọn">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <ui:SymbolIcon Symbol="{x:Static ui:Symbol.Delete}"/>
                                <TextBlock Text="Xóa lô"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <TextBox Watermark="Lọc theo tên dự án / nhà thầu..." Text="{Binding FilterText}"/>
                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="{DynamicResource DangerBrush}"
                           IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Classes="card" Padding="16,12" Margin="0,16,0,0">
            <TextBlock Text="{Binding SummaryFooter}" FontWeight="SemiBold"
                       Foreground="{DynamicResource BrandPrimaryBrush}"/>
        </Border>

        <Border Classes="card" Padding="0" ClipToBounds="True">
            <DataGrid ItemsSource="{Binding Rows}"
                  IsReadOnly="True"
                  GridLinesVisibility="Horizontal"
                  HeadersVisibility="Column"
                  AutoGenerateColumns="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="STT" Binding="{Binding Stt}" Width="50"/>
                <DataGridTextColumn Header="Sheet" Binding="{Binding SheetName}" Width="70"/>
                <DataGridTextColumn Header="Tên dự án" Binding="{Binding ProjectName}" Width="200"/>
                <DataGridTextColumn Header="Nhà thầu" Binding="{Binding ContractorName}" Width="160"/>
                <DataGridTextColumn Header="Giá trị HĐ" Binding="{Binding ContractValue, StringFormat=#\,##0}" Width="120"/>
                <DataGridTextColumn Header="Tạm ứng" Binding="{Binding Advance, StringFormat=#\,##0}" Width="110"/>
                <DataGridTextColumn Header="TT KLHT" Binding="{Binding PaymentKLHT, StringFormat=#\,##0}" Width="110"/>
                <DataGridTextColumn Header="Thu hồi TU" Binding="{Binding RecoveredAdvance, StringFormat=#\,##0}" Width="110"/>
                <DataGridTextColumn Header="TT cho NT" Binding="{Binding PaymentToContractor, StringFormat=#\,##0}" Width="110"/>
                <DataGridTextColumn Header="TU chưa TH" Binding="{Binding UnrecoveredAdvance, StringFormat=#\,##0}" Width="110"/>
                <DataGridTextColumn Header="GN NSNN" Binding="{Binding DisbursedNSNN, StringFormat=#\,##0}" Width="120"/>
                <DataGridTextColumn Header="GN Ngoại hối (DTNH)" Binding="{Binding DisbursedDTNH, StringFormat=#\,##0}" Width="140"/>
                <DataGridTextColumn Header="Tổng GN" Binding="{Binding TotalDisbursed, StringFormat=#\,##0}" Width="120"/>
                <DataGridTextColumn Header="Quyết toán theo năm" Binding="{Binding YearlySettlementsText}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
        </Border>
    </DockPanel>
</UserControl>
