<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ConstructionFinance.Desktop.ViewModels.Vendors"
             x:Class="ConstructionFinance.Desktop.Views.Vendors.VendorEditDialog"
             x:DataType="vm:VendorEditDialogViewModel"
             MinWidth="480">
    <Grid ColumnDefinitions="140,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto"
          Classes="formGrid">
        <TextBlock Grid.Row="0" Grid.Column="0" Classes="formLabel" Text="Mã NCC"/>
        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding VendorCode}"/>

        <TextBlock Grid.Row="1" Grid.Column="0" Classes="formLabel" Text="Tên nhà cung cấp *"/>
        <StackPanel Grid.Row="1" Grid.Column="1">
            <TextBox Text="{Binding VendorName}"/>
            <TextBlock Classes="fieldError" Text="{Binding VendorNameError}"
                       IsVisible="{Binding VendorNameError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
        </StackPanel>

        <TextBlock Grid.Row="2" Grid.Column="0" Classes="formLabel" Text="Mã số thuế"/>
        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding TaxCode}"/>

        <TextBlock Grid.Row="3" Grid.Column="0" Classes="formLabel" Text="Địa chỉ"/>
        <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Address}"/>

        <TextBlock Grid.Row="4" Grid.Column="0" Classes="formLabel" Text="Điện thoại"/>
        <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding Phone}"/>

        <TextBlock Grid.Row="5" Grid.Column="0" Classes="formLabel" Text="Email"/>
        <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding Email}"/>

        <TextBlock Grid.Row="6" Grid.Column="0" Classes="formLabel" Text="Người liên hệ"/>
        <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding ContactPerson}"/>

        <TextBlock Grid.Row="7" Grid.Column="0" Classes="formLabel" Text="Ghi chú" VerticalAlignment="Top"/>
        <TextBox Grid.Row="7" Grid.Column="1" Text="{Binding Notes}" AcceptsReturn="True" Height="80" TextWrapping="Wrap"/>
    </Grid>
</UserControl>
