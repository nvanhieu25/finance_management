<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:vm="using:ConstructionFinance.Desktop.ViewModels.Vendors"
             x:Class="ConstructionFinance.Desktop.Views.Vendors.VendorListView"
             x:DataType="vm:VendorListViewModel">
    <DockPanel>
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,16">
            <StackPanel Grid.Column="0" Spacing="2">
                <TextBlock Classes="pageTitle" Text="Nhà cung cấp"/>
                <TextBlock Classes="pageSubtitle" Text="Danh mục nhà thầu / nhà cung cấp"/>
            </StackPanel>
            <Button Grid.Column="1" Classes="accent toolbar" VerticalAlignment="Center"
                    Command="{Binding AddCommand}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <ui:SymbolIcon Symbol="{x:Static ui:Symbol.Add}"/>
                    <TextBlock Text="Thêm NCC"/>
                </StackPanel>
            </Button>
        </Grid>

        <Border Classes="tableCard">
            <DockPanel>
                <Border DockPanel.Dock="Top" Classes="toolbarStrip">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                            <Button Classes="toolbar" Command="{Binding EditCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <ui:SymbolIcon Symbol="{x:Static ui:Symbol.Edit}"/>
                                    <TextBlock Text="Sửa"/>
                                </StackPanel>
                            </Button>
                            <Button Classes="toolbar danger" Command="{Binding DeleteCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <ui:SymbolIcon Symbol="{x:Static ui:Symbol.Delete}"/>
                                    <TextBlock Text="Xóa"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding ErrorMessage}"
                                   Foreground="{DynamicResource DangerBrush}"
                                   VerticalAlignment="Center" HorizontalAlignment="Right" Margin="12,0"/>
                        <ProgressBar Grid.Column="2" IsIndeterminate="True" IsVisible="{Binding IsBusy}"
                                     Width="100" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
                <DataGrid ItemsSource="{Binding Vendors}"
                          SelectedItem="{Binding SelectedVendor}"
                          CanUserSortColumns="True"
                          IsReadOnly="True"
                          HeadersVisibility="Column">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Mã" Binding="{Binding VendorCode}" Width="100"/>
                        <DataGridTextColumn Header="Tên nhà cung cấp" Binding="{Binding VendorName}" Width="*"/>
                        <DataGridTextColumn Header="MST" Binding="{Binding TaxCode}" Width="120"/>
                        <DataGridTextColumn Header="SĐT" Binding="{Binding Phone}" Width="120"/>
                        <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="200"/>
                        <DataGridTextColumn Header="Người liên hệ" Binding="{Binding ContactPerson}" Width="160"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>
    </DockPanel>
</UserControl>
