<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ConstructionFinance.Desktop.ViewModels.Finance"
             xmlns:conv="using:ConstructionFinance.Desktop.Common"
             x:Class="ConstructionFinance.Desktop.Views.Finance.ProjectTongHopView"
             x:DataType="vm:ProjectTongHopViewModel">
    <!-- Cột và tên cột theo sheet "Tổng hợp" của Mẫu.xlsx, cùng thứ tự với bản in (ProjectTongHopPageViewModel). Bản in tách
         Quyết toán năm thành từng cặp cột NSNN/DTNH; màn hình gom vào một cột chữ để khỏi phải dựng cột theo số năm. -->
    <DockPanel Margin="0,4,0,0">
        <StackPanel DockPanel.Dock="Top" Margin="4,0,0,8" Spacing="2">
            <TextBlock Classes="pageSubtitle" FontWeight="SemiBold" Text="NGUỒN KINH PHÍ ĐẦU TƯ XÂY DỰNG"/>
            <TextBlock Classes="muted" Text="Đơn vị tính: đồng · TT KLHT = Thanh toán khối lượng hoàn thành"/>
        </StackPanel>
        <DataGrid Classes="report" ItemsSource="{Binding Rows}" IsReadOnly="True"
                  HeadersVisibility="Column"
                  CanUserResizeColumns="True" CanUserSortColumns="False">
            <DataGrid.Styles>
                <Style Selector="DataGridRow" x:DataType="vm:SummaryDisplayRow">
                    <Setter Property="FontWeight"
                            Value="{Binding IsBold, Converter={x:Static conv:BoolToFontWeightConverter.Instance}}"/>
                </Style>
            </DataGrid.Styles>
            <DataGrid.Columns>
                <DataGridTextColumn Header="STT" Binding="{Binding Ordinal}" Width="64" CellStyleClasses="center"/>
                <DataGridTextColumn Header="Tên vị trí" Binding="{Binding Label}" Width="200"/>
                <DataGridTextColumn Header="Đơn vị thi công&#10;xây lắp" Binding="{Binding Contractor}" Width="210"/>
                <DataGridTextColumn Header="Giá trị HĐ,&#10;PLHĐ xây lắp" Binding="{Binding ContractValue}" Width="132" CellStyleClasses="money"/>
                <DataGridTextColumn Header="Tạm ứng" Binding="{Binding Advance}" Width="124" CellStyleClasses="money"/>
                <DataGridTextColumn Header="TT KLHT:&#10;TT khối lượng&#10;hoàn thành" Binding="{Binding KLHT}" Width="124" CellStyleClasses="money"/>
                <DataGridTextColumn Header="TT KLHT:&#10;Thu hồi&#10;tạm ứng" Binding="{Binding Recovered}" Width="124" CellStyleClasses="money"/>
                <DataGridTextColumn Header="TT KLHT:&#10;TT tiền cho&#10;nhà thầu" Binding="{Binding DisbursedToContractor}" Width="124" CellStyleClasses="money"/>
                <DataGridTextColumn Header="Tạm ứng&#10;chưa thu hồi" Binding="{Binding Unrecovered}" Width="124" CellStyleClasses="money"/>
                <DataGridTextColumn Header="Giải ngân từ&#10;Dự phòng NSNN" Binding="{Binding NSNN}" Width="140" CellStyleClasses="money"/>
                <DataGridTextColumn Header="Giải ngân từ Quỹ&#10;dự trữ ngoại hối" Binding="{Binding NgoaiHoi}" Width="140" CellStyleClasses="money"/>
                <DataGridTextColumn Header="Tổng giá trị&#10;đã giải ngân" Binding="{Binding TotalDisbursed}" Width="124" CellStyleClasses="money"/>
                <DataGridTextColumn Header="Quyết toán năm&#10;(NSNN / DTNH)" Binding="{Binding YearlyText}" Width="280"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
