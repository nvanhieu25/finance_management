<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ConstructionFinance.Desktop.ViewModels.Finance"
             xmlns:conv="using:ConstructionFinance.Desktop.Common"
             x:Class="ConstructionFinance.Desktop.Views.Finance.YearSettlementView"
             x:DataType="vm:YearSettlementViewModel">
    <Border Classes="tableCard">
        <DockPanel>
            <Border DockPanel.Dock="Top" Classes="toolbarStrip">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="Quyết toán theo năm tài chính" Classes="sectionTitle" VerticalAlignment="Center"/>
                    <TextBlock Text="• Chu kỳ niên độ: 01/02 → 31/01 năm kế tiếp"
                               Classes="muted" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
            <DataGrid ItemsSource="{Binding Rows}" IsReadOnly="True"
                      GridLinesVisibility="All" HeadersVisibility="Column"
                      CanUserResizeColumns="True" CanUserSortColumns="False">
                <DataGrid.Styles>
                    <Style Selector="DataGridRow" x:DataType="vm:YearSettlementRow">
                        <Setter Property="FontWeight"
                                Value="{Binding IsBold, Converter={x:Static conv:BoolToFontWeightConverter.Instance}}"/>
                    </Style>
                </DataGrid.Styles>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Năm tài chính" Binding="{Binding YearLabel}" Width="240"/>
                    <DataGridTextColumn Header="Dự phòng NSNN" Binding="{Binding NSNN}" Width="200"/>
                    <DataGridTextColumn Header="Quỹ dự trữ ngoại hối" Binding="{Binding NgoaiHoi}" Width="220"/>
                    <DataGridTextColumn Header="Tổng giải ngân" Binding="{Binding Total}" Width="200"/>
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>
    </Border>
</UserControl>
