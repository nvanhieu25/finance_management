<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ConstructionFinance.Desktop.ViewModels.Finance"
             xmlns:conv="using:ConstructionFinance.Desktop.Common"
             x:Class="ConstructionFinance.Desktop.Views.Finance.YearSettlementView"
             x:DataType="vm:YearSettlementViewModel">
    <!-- Cùng cột và tên cột với bản in (YearSettlementPageViewModel). -->
    <DockPanel Margin="0,4,0,0">
        <StackPanel DockPanel.Dock="Top" Margin="4,0,0,8" Spacing="2">
            <TextBlock Classes="pageSubtitle" FontWeight="SemiBold" Text="QUYẾT TOÁN THEO NĂM TÀI CHÍNH"/>
            <TextBlock Classes="muted" Text="Năm tài chính từ 01/02 đến 31/01 năm sau · Đơn vị tính: đồng"/>
        </StackPanel>
        <DataGrid Classes="report" ItemsSource="{Binding Rows}" IsReadOnly="True"
                  HeadersVisibility="Column" HorizontalAlignment="Left"
                  CanUserResizeColumns="True" CanUserSortColumns="False">
            <DataGrid.Styles>
                <Style Selector="DataGridRow" x:DataType="vm:YearSettlementRow">
                    <Setter Property="FontWeight"
                            Value="{Binding IsBold, Converter={x:Static conv:BoolToFontWeightConverter.Instance}}"/>
                </Style>
            </DataGrid.Styles>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Năm tài chính" Binding="{Binding YearLabel}" Width="220"/>
                <DataGridTextColumn Header="Giải ngân&#10;Dự phòng NSNN" Binding="{Binding NSNN}" Width="180" CellStyleClasses="money"/>
                <DataGridTextColumn Header="Giải ngân Quỹ&#10;dự trữ ngoại hối" Binding="{Binding NgoaiHoi}" Width="180" CellStyleClasses="money"/>
                <DataGridTextColumn Header="Tổng cộng" Binding="{Binding Total}" Width="180" CellStyleClasses="money"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
