<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:vm="using:ConstructionFinance.Desktop.ViewModels.Contracts"
             x:Class="ConstructionFinance.Desktop.Views.Contracts.ContractDetailView"
             x:DataType="vm:ContractDetailViewModel">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="12" Margin="0,0,0,16">
            <Button Classes="toolbar" Command="{Binding GoBackCommand}" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <ui:SymbolIcon Symbol="{x:Static ui:Symbol.ChevronLeft}"/>
                    <TextBlock Text="Quay lại"/>
                </StackPanel>
            </Button>
            <TextBlock Classes="pageTitle" VerticalAlignment="Center"
                       Text="{Binding Contract.ContractCode, StringFormat='Hợp đồng {0}'}"/>
        </StackPanel>
        <Grid RowDefinitions="Auto,*">
            <Border Grid.Row="0" Classes="card" Margin="0,0,0,16">
                <Grid ColumnDefinitions="170,*" RowDefinitions="Auto,Auto,Auto,Auto">
                    <TextBlock Grid.Row="0" Grid.Column="0" Classes="fieldLabel" Text="Tên HĐ"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" Classes="fieldValueStrong" Text="{Binding Contract.ContractName}" TextWrapping="Wrap"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Classes="fieldLabel" Text="Ngày HĐ"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" Classes="fieldValue" Text="{Binding Contract.ContractDate}"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Classes="fieldLabel" Text="Giá trị HĐ"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" Classes="fieldValue" Text="{Binding Contract.ContractValue, StringFormat=#\,##0}"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" Classes="fieldLabel" Text="Ghi chú"/>
                    <TextBlock Grid.Row="3" Grid.Column="1" Classes="fieldValue" Text="{Binding Contract.Notes}" TextWrapping="Wrap"/>
                </Grid>
            </Border>
            <DockPanel Grid.Row="1">
                <TextBlock DockPanel.Dock="Top" Text="Dự án thuộc Hợp đồng này"
                           Classes="sectionTitle" Margin="0,0,0,8"/>
                <ContentControl Content="{Binding Projects}"/>
            </DockPanel>
        </Grid>
    </DockPanel>
</UserControl>
