<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:vm="using:ConstructionFinance.Desktop.ViewModels.Contracts"
             x:Class="ConstructionFinance.Desktop.Views.Contracts.ContractListView"
             x:DataType="vm:ContractListViewModel">
    <!-- Always shown embedded inside a Decision detail, so no page header here. -->
    <Border Classes="tableCard">
        <DockPanel>
            <Border DockPanel.Dock="Top" Classes="toolbarStrip">
                <Grid ColumnDefinitions="Auto,*">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                        <Button Classes="accent toolbar" Command="{Binding AddCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <ui:SymbolIcon Symbol="{x:Static ui:Symbol.Add}"/>
                                <TextBlock Text="Thêm"/>
                            </StackPanel>
                        </Button>
                        <Button Classes="toolbar" Command="{Binding EditCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <ui:SymbolIcon Symbol="{x:Static ui:Symbol.Edit}"/>
                                <TextBlock Text="Sửa"/>
                            </StackPanel>
                        </Button>
                        <Button Classes="toolbar danger" Command="{Binding DeleteCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <ui:SymbolIcon Symbol="{x:Static ui:Symbol.Delete}"/>
                                <TextBlock Text="Xóa"/>
                            </StackPanel>
                        </Button>
                        <Button Classes="toolbar" Command="{Binding OpenDetailCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <ui:SymbolIcon Symbol="{x:Static ui:Symbol.ChevronRight}"/>
                                <TextBlock Text="Chi tiết"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{Binding ErrorMessage}"
                               Foreground="{DynamicResource DangerBrush}"
                               VerticalAlignment="Center" HorizontalAlignment="Right" Margin="12,0"/>
                </Grid>
            </Border>
            <DataGrid ItemsSource="{Binding Contracts}"
                      SelectedItem="{Binding SelectedContract}"
                      IsReadOnly="True"
                      HeadersVisibility="Column">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Mã HĐ" Binding="{Binding ContractCode}" Width="150"/>
                    <DataGridTextColumn Header="Tên HĐ" Binding="{Binding ContractName}" Width="*"/>
                    <DataGridTextColumn Header="Ngày HĐ" Binding="{Binding ContractDate}" Width="110"/>
                    <DataGridTextColumn Header="Giá trị" Binding="{Binding ContractValue, StringFormat=#\,##0}" Width="160"/>
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>
    </Border>
</UserControl>
