<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:vm="using:ConstructionFinance.Desktop.ViewModels.Settings"
             x:Class="ConstructionFinance.Desktop.Views.Settings.CompanyInfoView"
             x:DataType="vm:CompanyInfoViewModel">
    <ScrollViewer Padding="16">
        <Border Classes="card" MaxWidth="780" HorizontalAlignment="Left">
            <StackPanel Spacing="14">
                <TextBlock Classes="sectionTitle" Text="Thông tin cơ quan"/>
                <Grid ColumnDefinitions="220,*">
                    <TextBlock Grid.Column="0" Classes="formLabel" Text="Tên cơ quan"/>
                    <TextBox Grid.Column="1" Text="{Binding CompanyName}"/>
                </Grid>
                <Grid ColumnDefinitions="220,*">
                    <TextBlock Grid.Column="0" Classes="formLabel" Text="Địa chỉ"/>
                    <TextBox Grid.Column="1" Text="{Binding CompanyAddress}"/>
                </Grid>
                <Grid ColumnDefinitions="220,*">
                    <TextBlock Grid.Column="0" Classes="formLabel" Text="Điện thoại"/>
                    <TextBox Grid.Column="1" Text="{Binding CompanyPhone}"/>
                </Grid>
                <Grid ColumnDefinitions="220,*">
                    <TextBlock Grid.Column="0" Classes="formLabel" Text="Email"/>
                    <TextBox Grid.Column="1" Text="{Binding CompanyEmail}"/>
                </Grid>
                <Grid ColumnDefinitions="220,*">
                    <TextBlock Grid.Column="0" Classes="formLabel" Text="Đường dẫn logo"/>
                    <TextBox Grid.Column="1" Text="{Binding LogoPath}"/>
                </Grid>
                <Grid ColumnDefinitions="220,*">
                    <TextBlock Grid.Column="0" Classes="formLabel" Text="Người ký mặc định"/>
                    <TextBox Grid.Column="1" Text="{Binding DefaultSignerName}"/>
                </Grid>
                <Grid ColumnDefinitions="220,*">
                    <TextBlock Grid.Column="0" Classes="formLabel" Text="Chức vụ người ký"/>
                    <TextBox Grid.Column="1" Text="{Binding DefaultSignerTitle}"/>
                </Grid>
                <TextBlock Classes="sectionTitle" Text="Tên đơn vị in trên biểu mẫu"/>
                <Grid ColumnDefinitions="220,*">
                    <TextBlock Grid.Column="0" Classes="formLabel" Text="Đơn vị cấp trên"/>
                    <TextBox Grid.Column="1" Text="{Binding DonViCapTren}"/>
                </Grid>
                <Grid ColumnDefinitions="220,*">
                    <TextBlock Grid.Column="0" Classes="formLabel" Text="Đơn vị cơ sở"/>
                    <TextBox Grid.Column="1" Text="{Binding DonViCoSo}"/>
                </Grid>
                <Grid ColumnDefinitions="220,*">
                    <TextBlock Grid.Column="0" Classes="formLabel" Text="Nơi nhận báo cáo mặc định" VerticalAlignment="Top"/>
                    <TextBox Grid.Column="1" Text="{Binding DefaultRecipients}" AcceptsReturn="True" Height="100" TextWrapping="Wrap"/>
                </Grid>
                <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,4,0,0">
                    <Button Classes="accent toolbar" Command="{Binding SaveCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <ui:SymbolIcon Symbol="{x:Static ui:Symbol.Save}"/>
                            <TextBlock Text="Lưu thay đổi"/>
                        </StackPanel>
                    </Button>
                    <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}" Width="80" VerticalAlignment="Center"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </ScrollViewer>
</UserControl>
