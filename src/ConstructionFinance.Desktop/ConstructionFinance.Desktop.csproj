<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Hai đích, một lý do: gói PDFsharp-MigraDoc-GDI chỉ có net8.0-windows7.0, nhưng
         468 test Desktop phải chạy được trên máy phát triển Linux. Đích net8.0 là đích
         bộ test lấy; đích net8.0-windows là bản phát hành, và CHỈ nó thấy dự án
         Printing.Windows. Directory.Build.props đặt TargetFramework toàn cục nên phải
         xóa trắng trước khi đặt TargetFrameworks. -->
    <TargetFramework></TargetFramework>
    <TargetFrameworks>net8.0;net8.0-windows</TargetFrameworks>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <OutputType>WinExe</OutputType>
    <RootNamespace>ConstructionFinance.Desktop</RootNamespace>
    <AssemblyName>ConstructionFinance</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- Icon của .exe trên Windows (Explorer, taskbar, Start Menu). Cùng một file
         được installer/inno-setup.iss dùng lại cho shortcut. -->
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Product>Quản lý Tài chính Công trình</Product>
    <Company>Sở Xây dựng</Company>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="FluentAvaloniaUI" />
    <PackageReference Include="Avalonia.Controls.TreeDataGrid" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" />
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Extensions.Hosting" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="Serilog.Sinks.Console" />
    <!-- Diagnostics ONLY in Debug -->
    <PackageReference Include="Avalonia.Diagnostics" Condition="'$(Configuration)' == 'Debug'" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ConstructionFinance.Application\ConstructionFinance.Application.csproj" />
    <ProjectReference Include="..\ConstructionFinance.Data\ConstructionFinance.Data.csproj" />
    <ProjectReference Include="..\ConstructionFinance.Domain\ConstructionFinance.Domain.csproj" />
    <ProjectReference Include="..\ConstructionFinance.Infrastructure\ConstructionFinance.Infrastructure.csproj" />
  </ItemGroup>

  <!-- Adapter máy in chỉ tồn tại ở đích Windows. Đích net8.0 (bộ test) không có
       IPrinterPort nào được đăng ký, nên hai lệnh In ra giấy mờ — xem Task 10. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0-windows'">
    <ProjectReference Include="..\ConstructionFinance.Printing.Windows\ConstructionFinance.Printing.Windows.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>
</Project>
