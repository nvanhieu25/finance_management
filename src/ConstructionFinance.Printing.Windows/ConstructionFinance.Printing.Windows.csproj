<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Directory.Build.props đặt TargetFramework=net8.0 cho mọi dự án; phải xóa trắng
         rồi đặt lại, nếu không giá trị toàn cục thắng và gói GDI không nạp được. -->
    <TargetFramework>net8.0-windows</TargetFramework>
    <!-- Để biên dịch (và kiểm kiểu) được dự án net8.0-windows trên Linux. Chạy thì vẫn phải Windows. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RootNamespace>ConstructionFinance.Printing.Windows</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ConstructionFinance.Application\ConstructionFinance.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="PDFsharp-MigraDoc-GDI" />
    <PackageReference Include="System.Drawing.Common" />
    <!-- ĐỪNG XOÁ hai dòng dưới. Application kéo theo bản lõi PDFsharp-MigraDoc, còn dự án này
         dùng bản GDI; thiếu hai dòng này build hỏng với CS0433 (XGraphics, XSize,
         DocumentRenderer tồn tại ở cả hai). Hai file MigraDoc.DocumentObjectModel.dll của hai
         bản giống hệt từng byte nên Document vẫn là MỘT kiểu; chỉ bộ dàn trang (renderer)
         khác nhau, và chỉ bản GDI được phép nạp. Trông như vô tác dụng nhưng không phải. -->
    <PackageReference Include="PDFsharp-MigraDoc" ExcludeAssets="all" />
    <PackageReference Include="PDFsharp" ExcludeAssets="all" />
  </ItemGroup>

</Project>
